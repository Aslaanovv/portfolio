# Contact Form Configuration
# Set up EmailJS at: https://www.emailjs.com/
# 1. Add an Email Service (Gmail) -> Service ID
# 2. Create an Email Template -> Template ID
# 3. Account -> API Keys -> Public Key

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Social / contact
# WhatsApp number in international format, digits only (e.g. 201234567890).
# Optional: src/data/site.ts already defaults to +20 111 666 5513.
VITE_WHATSAPP_NUMBER=201116665513

# Analytics & Monitoring

# Google Analytics 4 Measurement ID (optional)
# Get this from your GA4 property settings
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
